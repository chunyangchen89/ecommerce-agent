# Hosted chat model
LLM_BASE_URL=https://api.ofox.io/v1
LLM_API_KEY=
LLM_MODEL=deepseek/deepseek-v3.2

# Local Ollama embeddings
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_EMBED_DIM=1024

# PostgreSQL
POSTGRES_DSN=postgresql+asyncpg://ecommerce:ecommerce@localhost:5432/ecommerce

# Milvus
MILVUS_URI=http://localhost:19530

# Redis
REDIS_URL=redis://localhost:6379

# Langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# Embedding pipeline
EMBED_BATCH_SIZE=32
MILVUS_INSERT_BATCH=500
CHUNK_SIZE=1000
TOTAL_RECORDS=10000
